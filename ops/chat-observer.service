[Unit]
Description=Observer and authenticated input bridge for the configured Codex conversation
After=network.target

[Service]
User=root
Group=www-data
EnvironmentFile=/etc/lib-chat.env
ExecStart=/opt/lib-chat/bin/python /var/www/html/lib/ops/chat_observer.py
RuntimeDirectory=lib-chat-observer
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
StateDirectory=lib-chat-observer
StateDirectoryMode=0700
ReadWritePaths=/run/lib-chat-observer /var/lib/lib-chat-observer
UMask=0077

[Install]
WantedBy=multi-user.target
